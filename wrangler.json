{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "astro-blog-starter-template",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "astro-blog-emdash"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "astro-blog-emdash-media"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "7fbb2080a6c144d7895b6180efa3a214"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
